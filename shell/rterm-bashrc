# Started by rterm as `bash --rcfile <this file>`: run the user's normal startup first,
# then add shell integration. /etc/bash.bashrc is still read by bash itself.
if [[ -f ~/.bashrc ]]; then
  source ~/.bashrc
fi
if [[ -n ${RTERM_SHELL_INTEGRATION_DIR-} ]]; then
  source "$RTERM_SHELL_INTEGRATION_DIR/rterm.bash"
fi
